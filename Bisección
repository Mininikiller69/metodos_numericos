import math
import numpy as np

def biseccion(f, a, b, tol, max_iter=100):
    if f(a) * f(b) >= 0:
        return None  # El método no garantiza convergencia si no hay cambio de signo
    
    n_iter = 0
    while (b - a) / 2.0 > tol and n_iter < max_iter:
        punto_medio = (a + b) / 2.0
        if f(punto_medio) == 0:
            return punto_medio
        elif f(a) * f(punto_medio) < 0:
            b = punto_medio
        else:
            a = punto_medio
        n_iter += 1
    
    return (a + b) / 2.0
