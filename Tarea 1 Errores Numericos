# metodos_numericos
import math

# ==========================================
# Funciones Auxiliares
# ==========================================
def error_absoluto(p, p_star):
    return abs(p - p_star)

def error_relativo(p, p_star):
    if p == 0:
        return float('inf')
    return abs(p - p_star) / abs(p)

def round_sig(x, sig=3):
    """Redondea un número a 'sig' cifras significativas."""
    if x == 0:
        return 0.0
    return round(x, sig - int(math.floor(math.log10(abs(x)))) - 1)

def mostrar_errores(etiqueta, p, p_star):
    ea = error_absoluto(p, p_star)
    er = error_relativo(p, p_star)
    print(f"{etiqueta}:")
    print(f"  Valor exacto p = {p:.8g}")
    print(f"  Valor aprox p* = {p_star:.8g}")
    print(f"  Error Absoluto = {ea:.6e}")
    print(f"  Error Relativo = {er:.6e}\n")

