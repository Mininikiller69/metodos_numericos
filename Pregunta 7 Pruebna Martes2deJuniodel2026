import math
import matplotlib.pyplot as plt
import numpy as np

# Constante de Briggs
alpha = 1 / math.log(10)

# Método de Briggs:
# 5 raíces cuadradas consecutivas
# redondeando a 6 decimales
def briggs_log10(x):
    y = float(x)

    for _ in range(5):
        y = round(math.sqrt(y), 6)

    r = y - 1

    # Aproximación lineal
    log_aprox = alpha * r

    # log(x) = 2^5 * log(raiz_32(x))
    return (2 ** 5) * log_aprox


# Tabla de logaritmos
logs = {}

# Valores obtenidos directamente con Briggs
for x in [2, 3, 7]:
    logs[x] = briggs_log10(x)

# Usando propiedades
logs[4] = 2 * logs[2]
logs[5] = 1 - logs[2]          # log(5)=log(10)-log(2)
logs[6] = logs[2] + logs[3]    # log(6)=log(2)+log(3)
logs[8] = 3 * logs[2]          # log(8)=3log(2)
logs[9] = 2 * logs[3]          # log(9)=2log(3)

print("TABLA DE LOGARITMOS (BRIGGS)")
print("-" * 55)
print(f"{'x':<5}{'Aprox':<18}{'Real':<18}{'Error Relativo'}")

for x in range(1, 11):

    if x == 1:
        aprox = 0.0
    elif x == 10:
        aprox = 1.0
    else:
        aprox = logs[x]

    real = math.log10(x)

    if real == 0:
        error_rel = 0
    else:
        error_rel = abs((aprox - real) / real)

    print(f"{x:<5}{aprox:<18.10f}{real:<18.10f}{error_rel:.10f}")

# Comparación para log(6)
directo_6 = briggs_log10(6)
propiedad_6 = logs[6]
real_6 = math.log10(6)

error_directo = abs(directo_6 - real_6)
error_propiedad = abs(propiedad_6 - real_6)

print("\nCOMPARACIÓN PARA log10(6)")
print("-" * 40)
print("Método directo:", directo_6)
print("Error:", error_directo)

print("\nUsando log(2)+log(3):", propiedad_6)
print("Error:", error_propiedad)

if error_propiedad < error_directo:
    print("\nMejor aproximación: log(6)=log(2)+log(3)")
else:
    print("\nMejor aproximación: Método directo")

# Gráfica de la aproximación lineal
r = np.linspace(-0.1, 0.1, 1000)

real = np.log10(1 + r)
aprox = alpha * r

error_abs = np.abs(real - aprox)
error_max = np.max(error_abs)

print("\nMáximo error absoluto:", error_max)

plt.figure(figsize=(8, 5))
plt.plot(r, real, label='log10(1+r)')
plt.plot(r, aprox, '--', label='αr')
plt.xlabel('r')
plt.ylabel('Valor')
plt.title('Aproximación de Briggs')
plt.legend()
plt.grid(True)
plt.show()
