    error_taylor1[n] = abs(f1(x_test1) - y_taylor)

error_lagrange1 = {}
for n, pts in lagrange_puntos_1.items():
    y_lagrange = lagrange_poly(np.array([x_test1]), pts, f1(pts))[0]
    error_lagrange1[n] = abs(f1(x_test1) - y_lagrange)

