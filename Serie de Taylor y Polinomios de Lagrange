# EJERCICIO 2: f(x) = arctan(x), x0 = 1
# ============================================================================

def f2(x):
    return np.arctan(x)

def taylor_arctan_sympy(x, x0, n):
    """Calcula Taylor de arctan usando sympy"""
    x_sym = sp.Symbol('x')
    f_sym = sp.atan(x_sym)
    resultado = 0
    for k in range(n + 1):
        derivada = sp.diff(f_sym, x_sym, k)
        valor = float(derivada.subs(x_sym, x0))
        resultado += (valor / factorial(k)) * (x - x0)**k
    return resultado

