# EJERCICIO 1: f(x) = 125*x^2 + 1, x0 = 0
# ============================================================================

def f1(x):
    return 125*x**2 + 1

# Derivadas para Taylor
def derivadas_f1(x0, n_max):
    derivadas = []
    for n in range(n_max + 1):
        if n == 0:
            derivadas.append(f1(x0))
        elif n == 1:
            derivadas.append(250*x0)
        elif n == 2:
            derivadas.append(250)
        else:
            derivadas.append(0)
    return derivadas

def taylor_f1(x, x0, n):
    resultado = 0
    for k in range(n + 1):
        if k == 0:
            derivada = f1(x0)
        elif k == 1:
            derivada = 250*x0
        elif k == 2:
            derivada = 250
        else:
            derivada = 0
        resultado += (derivada / factorial(k)) * (x - x0)**k
    return resultado

# Polinomios de Lagrange
def lagrange_poly(x, x_points, y_points):
    n = len(x_points)
    resultado = np.zeros_like(x)
    for i in range(n):
        termino = np.ones_like(x)
        for j in range(n):
            if i != j:
                termino *= (x - x_points[j]) / (x_points[i] - x_points[j])
        resultado += y_points[i] * termino
    return resultado

