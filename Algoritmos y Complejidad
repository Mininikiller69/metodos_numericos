def chop_sig(x, sig=3):
    """Trunca (corta) un número a 'sig' cifras significativas."""
    if x == 0:
        return 0.0
    sign = 1 if x > 0 else -1
    x = abs(x)
    exponent = math.floor(math.log10(x))
    factor = 10**(sig - 1 - exponent)
    # math.floor asegura que se trunque (corte) hacia abajo
    chopped = math.floor(x * factor) / factor
    return sign * chopped

