print("\nDISCUSIÓN 3: Iteración de Identidad")
x = 0.25
right_side = (1 + 2*x) / (1 + x + x**2)

n_disc = 0
left_side = 0.0

while True:
    num = (2**n_disc) * (x**(2**n_disc - 1)) - (2**(n_disc + 1)) * (x**(2**(n_disc + 1) - 1))
    den = 1 - x**(2**n_disc) + x**(2**(n_disc + 1))
    left_side += num / den
    
    if abs(left_side - right_side) < 1e-6:
        break
    n_disc += 1

print(f"Para x = {x}, la diferencia es menor a 10^-6 con un total de n = {n_disc + 1} términos ")
print(f"Valor convergido: {left_side:.7f} vs Exacto: {right_side:.7f}")
