# 3: Aproximación de pi = 16 arctan(1/5) - 4 arctan(1/239)
def arctan_term(x, n):
    return ((-1)**(n+1)) * (x**(2*n - 1)) / (2*n - 1)

n_3 = 1
aprox_pi = 0
while True:
    term_5 = 16 * arctan_term(1/5, n_3)
    term_239 = 4 * arctan_term(1/239, n_3)
    aprox_pi += (term_5 - term_239)
    if abs(aprox_pi - math.pi) < 1e-3:
        break
    n_3 += 1
print(f"3: Utilizando la fórmula mejorada, se requieren solo n = {n_3} términos para error < 10^-3")


