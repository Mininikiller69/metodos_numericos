import math

# ==========================================
# IMPLEMENTACIÓN DE LOS MÉTODOS NUMÉRICOS
# ==========================================

def newton(f, df, p0, tol=1e-7, max_iter=100, verbose=False):
    """Método de Newton-Raphson."""
    p_prev = p0
    for i in range(1, max_iter + 1):
        derivada = df(p_prev)
        if derivada == 0:
            if verbose: print(f"  [!] Error: Derivada cero en la iteración {i}. El método falla.")
            return None
        
        p = p_prev - f(p_prev) / derivada
        if verbose: print(f"  Iter {i}: p_{i} = {p:.8f} | f(p_{i}) = {f(p):.8f}")
        
        if abs(p - p_prev) < tol:
            return p
        p_prev = p
    if verbose: print("  [!] Máximo de iteraciones alcanzado.")
    return p_prev

def secante(f, p0, p1, tol=1e-7, max_iter=100, verbose=False):
    """Método de la Secante."""
    for i in range(2, max_iter + 2):
        denominador = f(p1) - f(p0)
        if denominador == 0:
            if verbose: print(f"  [!] Error: División por cero en la iteración {i}.")
            return None
        
        p = p1 - f(p1) * (p1 - p0) / denominador
        if verbose: print(f"  Iter {i}: p_{i} = {p:.8f} | f(p_{i}) = {f(p):.8f}")
        
        if abs(p - p1) < tol:
            return p
        p0, p1 = p1, p
    if verbose: print("  [!] Máximo de iteraciones alcanzado.")
    return p

def biseccion(f, a, b, num_iters):
    """Método de Bisección (fijo a número de iteraciones para el Ejercicio 5)."""
    for i in range(1, num_iters + 1):
        p = a + (b - a) / 2
        print(f"  Iter {i}: p = {p:.8f}")
        if f(p) == 0: break
        if f(a) * f(p) < 0:
            b = p
        else:
            a = p
    return p

# Función auxiliar para raíces cúbicas reales (Ejercicio 7)
def cbrt(x):
    return math.copysign(abs(x)**(1/3), x)

