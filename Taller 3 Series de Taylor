import numpy as np
import matplotlib.pyplot as plt
import sympy as sp

# Variable simbólica
x = sp.Symbol('x')

# Órdenes de Taylor
ordenes = [0, 2, 4, 6, 8, 10, 12]

# =====================================
# SERIE DE TAYLOR
# =====================================

def taylor(f, x0, n):
    return sp.series(f, x, x0, n + 1).removeO()

def graficar_taylor(nombre, f_sym, f_num, x0, xmin, xmax):

    xx = np.linspace(xmin, xmax, 2000)
    yy_real = f_num(xx)

    print("\n" + "="*60)
    print(nombre)
    print("="*60)

    for n in ordenes:

        pol = sp.expand(taylor(f_sym, x0, n))

        print(f"\nPolinomio de Taylor orden {n}:")
        print(pol)

        p = sp.lambdify(x, pol, "numpy")
        yy = p(xx)

        if np.isscalar(yy):
            yy = np.full_like(xx, float(yy))

        # Función y aproximación
        plt.figure(figsize=(10, 5))
        plt.plot(xx, yy_real, label="Función original", linewidth=3)
        plt.plot(xx, yy, "--", label=f"Taylor orden {n}", linewidth=3)
        plt.title(f"{nombre} - Orden {n}")
        plt.xlabel("x")
        plt.ylabel("y")
        plt.grid(True)
        plt.legend()
        plt.show()

        # Error
        error = np.abs(yy_real - yy)

        plt.figure(figsize=(10, 4))
        plt.plot(xx, error)
        plt.title(f"Error absoluto - Orden {n}")
        plt.xlabel("x")
        plt.ylabel("|f(x)-Pn(x)|")
        plt.grid(True)
        plt.show()

# =====================================
# LAGRANGE
# =====================================

def lagrange(xd, yd):

    n = len(xd)
    P = 0

    for i in range(n):

        Li = 1

        for j in range(n):

            if i != j:
                Li *= (x - xd[j]) / (xd[i] - xd[j])

        P += yd[i] * Li

    return sp.expand(P)

def graficar_lagrange(nombre, xd, yd):

    P = lagrange(xd, yd)

    print("\n" + "="*60)
    print(nombre)
    print("="*60)

    print("\nPolinomio interpolante:")
    print(P)

    p = sp.lambdify(x, P, "numpy")

    xx = np.linspace(min(xd)-5, max(xd)+5, 1000)
    yy = p(xx)

    plt.figure(figsize=(10, 5))
    plt.plot(xx, yy, label="Polinomio de Lagrange")
    plt.scatter(xd, yd, s=100, color="red", label="Datos")
    plt.title(nombre)
    plt.xlabel("x")
    plt.ylabel("y")
    plt.grid(True)
    plt.legend()
    plt.show()

# =====================================
# COS(x), x0 = 0
# =====================================

graficar_taylor(
    "cos(x), x0 = 0",
    sp.cos(x),
    np.cos,
    0,
    -8,
    8
)

# =====================================
# 1/(1-x), x0 = 0
# =====================================

graficar_taylor(
    "1/(1-x), x0 = 0",
    1/(1-x),
    lambda z: 1/(1-z),
    0,
    -0.9,
    0.9
)

# =====================================
# ln(x), x0 = 1
# =====================================

graficar_taylor(
    "ln(x), x0 = 1",
    sp.ln(x),
    np.log,
    1,
    0.1,
    3
)

# =====================================
# LAGRANGE 1
# (0,0),(30,0.5),(60,3√2),(90,1)
# =====================================

graficar_lagrange(
    "Lagrange 1",
    [0, 30, 60, 90],
    [0, 0.5, 3*np.sqrt(2), 1]
)

# =====================================
# LAGRANGE 2
# (1,1),(2,2),(3,2)
# =====================================

graficar_lagrange(
    "Lagrange 2",
    [1, 2, 3],
    [1, 2, 2]
)

# =====================================
# LAGRANGE 3
# (-2,5),(1,7),(3,11),(7,34)
# =====================================

graficar_lagrange(
    "Lagrange 3",
    [-2, 1, 3, 7],
    [5, 7, 11, 34]
)
