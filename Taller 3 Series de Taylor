# (0,0),(30,0.5),(60,sqrt(3)/2),(90,1)
# =====================================================

x1 = np.array([0, 30, 60, 90], dtype=float)

y1 = np.array([
    0,
    0.5,
    np.sqrt(3)/2,
    1
