# Aplicado 1: Abrevadero
# V = L * [0.5*pi*r^2 - r^2*arcsin(h/r) - h*(r^2 - h^2)^(1/2)]
# Datos: L = 10, r = 1, V = 12.4
L = 10.0
r = 1.0
V_obj = 12.4

def f_volumen(h):
    # Ecuación a igualar a cero: V(h) - 12.4 = 0
    termino1 = 0.5 * np.pi * r**2
    termino2 = r**2 * np.arcsin(h/r)
    termino3 = h * np.sqrt(r**2 - h**2)
    return L * (termino1 - termino2 - termino3) - V_obj

# El valor de 'h' representa la distancia desde la parte superior.
# El intervalo lógico para h está entre 0 (lleno) y r (medio lleno).
h_sol = biseccion(f_volumen, 0, 1, 0.01, name="App 1: Abrevadero (distancia h)")
if h_sol is not None:
    profundidad = r - h_sol # La profundidad del agua es el radio menos la distancia h
    print(f"  > La profundidad del agua es aproximadamente: {profundidad:.4f} cm")

# Aplicado 2: Caída libre con resistencia
# s(t) = s0 - (m*g/k)*t + (m^2*g/k^2)*(1 - e^(-k*t/m))
# Datos: s0=300, m=0.25, k=0.1, g=9.81
s0 = 300.0
m = 0.25
k = 0.1
g = 9.81

def f_caida(t):
    termino1 = (m * g / k) * t
    termino2 = ((m**2 * g) / k**2) * (1 - np.exp(-k * t / m))
    return s0 - termino1 + termino2

# Buscamos t cuando s(t) = 0. Un buen intervalo inicial de tiempo estimado es [10, 20] segundos.
biseccion(f_caida, 10, 20, 0.01, name="App 2: Objeto en caída libre (tiempo t)")
