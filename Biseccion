import numpy as np
import math

def biseccion(f, a, b, tol, max_iter=100, name=""):
    """
    Implementación del método de bisección.
    """
    if f(a) * f(b) >= 0:
        print(f"[{name}] El intervalo [{a}, {b}] no cambia de signo o es inválido.")
        return None

    print(f"\n--- Resolviendo: {name} en intervalo [{a}, {b}] con tolerancia {tol} ---")
    
    n = 1
    while n <= max_iter:
        p = a + (b - a) / 2.0
        if np.abs(f(p)) < 1e-15 or (b - a) / 2.0 < tol:
            print(f"  Raíz encontrada: p = {p:.5f} en {n} iteraciones.")
            return p
        
        if f(a) * f(p) > 0:
            a = p
        else:
            b = p
        n += 1

    print("  El método fracasó después de", max_iter, "iteraciones.")
    return None

